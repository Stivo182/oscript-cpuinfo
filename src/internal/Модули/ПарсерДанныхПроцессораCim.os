#Область ПрограммныйИнтерфейс

// Разбирает JSON, сформированный командой Get-CimInstance.
// Поддерживает результат с одним процессором и массив процессоров.
//
// Параметры:
//   ТекстJSON - Строка - сериализованные записи Win32_Processor.
//
// Возвращаемое значение:
//   Массив из Структура - записи Win32_Processor.
Функция Распарсить(ТекстJSON) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	ПрочитанныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(ПрочитанныеДанные) = Тип("Массив") Тогда
		Возврат ПрочитанныеДанные;
	КонецЕсли;

	ЭкземплярыПроцессоров = Новый Массив();
	ЭкземплярыПроцессоров.Добавить(ПрочитанныеДанные);

	Возврат ЭкземплярыПроцессоров;

КонецФункции

#КонецОбласти
