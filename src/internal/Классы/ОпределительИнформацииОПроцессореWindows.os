#Область ПрограммныйИнтерфейс

// Получает информацию о процессоре через WMIC с резервным переходом на CIM.
//
// Параметры:
//   КомандаWmic - Команда - команда получения информации через WMIC.
//   КомандаCim - Команда - резервная команда получения информации через CIM.
//
// Возвращаемое значение:
//   ИнформацияОПроцессоре - полная информация от первого исправного источника.
//
// Исключения:
//   Не удалось получить информацию о процессоре - если оба источника завершились неудачно.
Функция Определить(КомандаWmic, КомандаCim) Экспорт

	ПричинаОшибкиWmic = "";
	ИнформацияОПроцессоре = ПолучитьИзКоманды(КомандаWmic, "WMIC", ПричинаОшибкиWmic);
	Если ИнформацияЗаполнена(ИнформацияОПроцессоре) Тогда
		Возврат ИнформацияОПроцессоре;
	КонецЕсли;

	ПричинаОшибкиCim = "";
	ИнформацияОПроцессоре = ПолучитьИзКоманды(КомандаCim, "CIM", ПричинаОшибкиCim);
	Если ИнформацияЗаполнена(ИнформацияОПроцессоре) Тогда
		Возврат ИнформацияОПроцессоре;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Не удалось получить информацию о процессоре. WMIC: %1; CIM: %2",
		ПричинаОшибкиWmic,
		ПричинаОшибкиCim);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьИзКоманды(Команда, СпособПолучения, ПричинаОшибки)

	Попытка
		Команда.Исполнить();
		Если СпособПолучения = "WMIC" Тогда
			ИнформацияОПроцессоре = ПарсерИнформацииОПроцессореWmic.Распарсить(Команда.ПолучитьВывод());
		Иначе
			ИнформацияОПроцессоре = ПарсерИнформацииОПроцессореCim.Распарсить(Команда.ПолучитьВывод());
		КонецЕсли;
	Исключение
		ПричинаОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Если Не ИнформацияЗаполнена(ИнформацияОПроцессоре) Тогда
		ПричинаОшибки = "результат не содержит обязательные сведения о процессоре";
		Возврат Неопределено;
	КонецЕсли;

	Возврат ИнформацияОПроцессоре;

КонецФункции

Функция ИнформацияЗаполнена(ИнформацияОПроцессоре)

	Возврат ИнформацияОПроцессоре <> Неопределено
		И ЗначениеЗаполнено(ИнформацияОПроцессоре.ИмяПроцессора)
		И ИнформацияОПроцессоре.КоличествоЯдер > 0
		И ИнформацияОПроцессоре.КоличествоЛогическихПроцессоров > 0
		И ЗначениеЗаполнено(ИнформацияОПроцессоре.Архитектура);

КонецФункции

#КонецОбласти
