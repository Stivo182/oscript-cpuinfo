#Область ПрограммныйИнтерфейс

// Внутренний парсер фактов о процессорах из содержимого /proc/cpuinfo.

// Разбирает содержимое /proc/cpuinfo в факты о моделях, топологии и максимальной частоте.
//
// Параметры:
//   Cpuinfo - Строка - содержимое файла /proc/cpuinfo.
//
// Возвращаемое значение:
//   Структура - факты о процессорах:
//     * ИменаМоделей - Массив - уникальные значения поля model name.
//     * ИмяПроцессора - Строка - первое непустое значение поля Processor.
//     * Оборудование - Строка - первое непустое значение поля Hardware.
//     * КоличествоЛогическихПроцессоров - Число - количество полей processor.
//     * КоличествоПроцессоров - Число - количество уникальных physical id.
//     * КоличествоЯдерПоИдентификаторам - Соответствие - ключи Строка "<physical id>:<core id>",
//                                                          значения Булево (Истина).
//     * КоличествоЯдерПоПроцессорам - Соответствие - ключи Строка physical id,
//                                                    значения Число количества cpu cores.
//     * МаксимальнаяЧастота - Число - последняя положительная max freq, переведенная в Гц.
Функция Распарсить(Cpuinfo) Экспорт

	Факты = СоздатьФакты();
	ИдентификаторыПроцессоров = Новый Соответствие();
	Процессоры = Новый ПарсерСекцийИнформацииОПроцессоре().РаспарситьСекции(Cpuinfo, ":");

	Для Каждого Процессор Из Процессоры Цикл

		ИдентификаторПроцессора = Процессор["physical id"];
		Если ЗначениеЗаполнено(ИдентификаторПроцессора) Тогда
			ИдентификаторыПроцессоров.Вставить(ИдентификаторПроцессора, Истина);
		КонецЕсли;

		ИдентификаторЯдра = Процессор["core id"];
		Если ЗначениеЗаполнено(ИдентификаторПроцессора)
			И ЗначениеЗаполнено(ИдентификаторЯдра) Тогда
			КлючЯдра = СтрШаблон("%1:%2", ИдентификаторПроцессора, ИдентификаторЯдра);
			Факты.КоличествоЯдерПоИдентификаторам.Вставить(КлючЯдра, Истина);
		КонецЕсли;

		КоличествоЯдер = КонвертацияЗначенийCpuInfo.СтрокаВЧисло(Процессор["cpu cores"]);
		Если ЗначениеЗаполнено(ИдентификаторПроцессора) И КоличествоЯдер > 0 Тогда
			Факты.КоличествоЯдерПоПроцессорам.Вставить(ИдентификаторПроцессора, КоличествоЯдер);
		КонецЕсли;

		ИмяМодели = Процессор["model name"];
		Если ЗначениеЗаполнено(ИмяМодели)
			И Факты.ИменаМоделей.Найти(ИмяМодели) = Неопределено Тогда
			Факты.ИменаМоделей.Добавить(ИмяМодели);
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Факты.ИмяПроцессора)
			И ЗначениеЗаполнено(Процессор["Processor"]) Тогда
			Факты.ИмяПроцессора = Процессор["Processor"];
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Факты.Оборудование)
			И ЗначениеЗаполнено(Процессор["Hardware"]) Тогда
			Факты.Оборудование = Процессор["Hardware"];
		КонецЕсли;

		Если ЗначениеЗаполнено(Процессор["processor"]) Тогда
			Факты.КоличествоЛогическихПроцессоров = Факты.КоличествоЛогическихПроцессоров + 1;
		КонецЕсли;

		МаксимальнаяЧастота = КонвертацияЗначенийCpuInfo.СтрокаВЧисло(Процессор["max freq"]);
		МаксимальнаяЧастота = КонвертацияЗначенийCpuInfo.МегагерцыВГерцы(МаксимальнаяЧастота);
		Если МаксимальнаяЧастота > 0 Тогда
			Факты.МаксимальнаяЧастота = МаксимальнаяЧастота;
		КонецЕсли;

	КонецЦикла;

	Факты.КоличествоПроцессоров = ИдентификаторыПроцессоров.Количество();

	Возврат Факты;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает структуру с начальными значениями фактов о процессорах.
//
// Возвращаемое значение:
//   Структура - пустой набор фактов о процессорах.
Функция СоздатьФакты()

	Факты = Новый Структура();
	Факты.Вставить("ИменаМоделей", Новый Массив());
	Факты.Вставить("ИмяПроцессора", "");
	Факты.Вставить("Оборудование", "");
	Факты.Вставить("КоличествоЛогическихПроцессоров", 0);
	Факты.Вставить("КоличествоПроцессоров", 0);
	Факты.Вставить("КоличествоЯдерПоИдентификаторам", Новый Соответствие());
	Факты.Вставить("КоличествоЯдерПоПроцессорам", Новый Соответствие());
	Факты.Вставить("МаксимальнаяЧастота", 0);

	Возврат Факты;

КонецФункции

#КонецОбласти
