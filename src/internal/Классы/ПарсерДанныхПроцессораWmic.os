#Область ПрограммныйИнтерфейс

// Внутренний парсер вывода WMIC /Format:List.

// Разбирает вывод WMIC /Format:List на отдельные записи процессоров.
//
// Параметры:
//   Текст - Строка - вывод команды WMIC.
//
// Возвращаемое значение:
//   Массив из Соответствие - значения свойств Win32_Processor.
Функция Распарсить(Текст) Экспорт

	ИсправитьВыводWmic(Текст);
	Секции = ПарсерСекцийИнформацииОПроцессоре.РаспарситьСекции(Текст, "=");
	Результат = Новый Массив();

	Для Каждого Секция Из Секции Цикл
		Если Секция.Количество() > 0 Тогда
			Результат.Добавить(Секция);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет лишний перевод строки в начале вывода WMIC.
//
// Параметры:
//   Текст - Строка - исправляемый вывод WMIC.
Процедура ИсправитьВыводWmic(Текст)

	Если Не ЗначениеЗаполнено(Текст) Или СтрЧислоСтрок(Текст) <= 1 Тогда
		Возврат;
	КонецЕсли;

	ПерваяСтрока = СтрПолучитьСтроку(Текст, 1);
	ВтораяСтрока = СтрПолучитьСтроку(Текст, 2);
	ВКПС = Символы.ВК + Символы.ПС;

	Если ЗначениеЗаполнено(ПерваяСтрока) И Не ЗначениеЗаполнено(ВтораяСтрока) Тогда
		Текст = СтрЗаменить(Текст, ВКПС + ВКПС, ВКПС);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
