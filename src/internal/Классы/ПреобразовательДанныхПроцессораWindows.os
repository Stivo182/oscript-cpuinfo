#Использовать logos

Перем _Лог; // Лог

#Область ОбработчикиСобытий

// Преобразует данные экземпляров Win32_Processor в информацию о процессоре.
Процедура ПриСозданииОбъекта()

	_Лог = Логирование.ПолучитьЛог("oscript.lib.cpuinfo.windows.converter");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Преобразует данные экземпляров Win32_Processor в информацию о процессоре.
//
// Параметры:
//   ДанныеПроцессоров - Массив из Структура, Соответствие - записи Win32_Processor:
//     * Name - Строка - имя процессора;
//     * Architecture - Строка, Число - код архитектуры процессора;
//     * NumberOfCores - Строка, Число - количество физических ядер;
//     * NumberOfLogicalProcessors - Строка, Число - количество логических процессоров;
//     * MaxClockSpeed - Строка, Число - максимальная частота в мегагерцах, 0 если неизвестна.
//
// Возвращаемое значение:
//   ИнформацияОПроцессоре - объединенные характеристики процессоров.
//
// Исключения:
//   Данные процессора не содержат обязательные сведения - если массив пуст или хотя бы одна запись неполная.
Функция Преобразовать(ДанныеПроцессоров) Экспорт

	_Лог.Отладка("Преобразование данных процессоров Windows: записей %1", ДанныеПроцессоров.Количество());

	Если ДанныеПроцессоров.Количество() = 0 Тогда
		ВызватьИсключение "Данные процессора не содержат обязательные сведения";
	КонецЕсли;

	Информация = Новый ИнформацияОПроцессоре(Ложь);
	ИменаПроцессоров = Новый Массив();
	СуммаМаксимальныхЧастот = 0;
	КоличествоМаксимальныхЧастот = 0;

	Для Каждого ЗаписьПроцессора Из ДанныеПроцессоров Цикл
		ДанныеПроцессора = Нормализовать(ЗаписьПроцессора);
		ПроверитьДанныеПроцессора(ДанныеПроцессора);
		Информация.КоличествоПроцессоров = Информация.КоличествоПроцессоров + 1;

		Если ДанныеПроцессора.КоличествоЯдер > 0 Тогда
			Информация.КоличествоЯдер = Информация.КоличествоЯдер + ДанныеПроцессора.КоличествоЯдер;
		КонецЕсли;

		Если ДанныеПроцессора.КоличествоЛогическихПроцессоров > 0 Тогда
			Информация.КоличествоЛогическихПроцессоров = Информация.КоличествоЛогическихПроцессоров
				+ ДанныеПроцессора.КоличествоЛогическихПроцессоров;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДанныеПроцессора.Имя)
			И ИменаПроцессоров.Найти(ДанныеПроцессора.Имя) = Неопределено Тогда
			ИменаПроцессоров.Добавить(ДанныеПроцессора.Имя);
		КонецЕсли;

		Если ДанныеПроцессора.МаксимальнаяЧастотаМГц > 0 Тогда
			СуммаМаксимальныхЧастот = СуммаМаксимальныхЧастот + ДанныеПроцессора.МаксимальнаяЧастотаМГц;
			КоличествоМаксимальныхЧастот = КоличествоМаксимальныхЧастот + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДанныеПроцессора.Архитектура) Тогда
			Информация.Архитектура = ДанныеПроцессора.Архитектура;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоМаксимальныхЧастот > 0 Тогда
		МаксимальнаяЧастотаМГц = СуммаМаксимальныхЧастот / КоличествоМаксимальныхЧастот;
		Информация.МаксимальнаяЧастота = КонвертацияЗначенийCpuInfo.МегагерцыВГерцы(МаксимальнаяЧастотаМГц);
	КонецЕсли;

	Информация.НоминальнаяЧастота = Информация.МаксимальнаяЧастота;
	Информация.ИмяПроцессора = СтрСоединить(ИменаПроцессоров, ", ");
	_Лог.Отладка(
		"Данные процессоров преобразованы: процессоров %1, ядер %2, логических процессоров %3",
		Информация.КоличествоПроцессоров,
		Информация.КоличествоЯдер,
		Информация.КоличествоЛогическихПроцессоров);

	Возврат Информация;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Нормализовать(ЗаписьПроцессора)

	ДанныеПроцессора = Новый Структура;
	ДанныеПроцессора.Вставить("Имя", СокрЛП(Строка(ЗаписьПроцессора["Name"])));
	ДанныеПроцессора.Вставить(
		"Архитектура",
		АрхитектураПоКоду(ЗаписьПроцессора["Architecture"]));
	ДанныеПроцессора.Вставить(
		"КоличествоЯдер",
		КонвертацияЗначенийCpuInfo.СтрокаВЧисло(ЗаписьПроцессора["NumberOfCores"]));
	ДанныеПроцессора.Вставить(
		"КоличествоЛогическихПроцессоров",
		КонвертацияЗначенийCpuInfo.СтрокаВЧисло(ЗаписьПроцессора["NumberOfLogicalProcessors"]));
	ДанныеПроцессора.Вставить(
		"МаксимальнаяЧастотаМГц",
		КонвертацияЗначенийCpuInfo.СтрокаВЧисло(ЗаписьПроцессора["MaxClockSpeed"]));

	Возврат ДанныеПроцессора;

КонецФункции

Функция АрхитектураПоКоду(КодАрхитектуры)

	Если СокрЛП(Строка(КодАрхитектуры)) = "" Тогда
		Возврат "";
	КонецЕсли;

	ЧисловойКодАрхитектуры = КонвертацияЗначенийCpuInfo.СтрокаВЧисло(КодАрхитектуры);

	Если ЧисловойКодАрхитектуры = 0 Тогда
		Возврат АрхитектурыПроцессоров.X86;
	ИначеЕсли ЧисловойКодАрхитектуры = 5 Тогда
		Возврат АрхитектурыПроцессоров.ARM;
	ИначеЕсли ЧисловойКодАрхитектуры = 9 Тогда
		Возврат АрхитектурыПроцессоров.X64;
	ИначеЕсли ЧисловойКодАрхитектуры = 12 Тогда
		Возврат АрхитектурыПроцессоров.ARM64;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Процедура ПроверитьДанныеПроцессора(ДанныеПроцессора)

	Если Не ЗначениеЗаполнено(ДанныеПроцессора.Имя)
		Или ДанныеПроцессора.КоличествоЯдер <= 0
		Или ДанныеПроцессора.КоличествоЛогическихПроцессоров <= 0
		Или Не ЗначениеЗаполнено(ДанныеПроцессора.Архитектура) Тогда
		ВызватьИсключение "Данные процессора не содержат обязательные сведения";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
