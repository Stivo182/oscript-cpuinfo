#Область ПрограммныйИнтерфейс

// Получает содержимое /proc/cpuinfo.
//
// Возвращаемое значение:
//   Строка - содержимое файла /proc/cpuinfo.
Функция Получить() Экспорт

	ЧтениеТекста = Новый ЧтениеТекста("/proc/cpuinfo");
	Попытка
		Результат = ЧтениеТекста.Прочитать();
	Исключение
		ЧтениеТекста.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	ЧтениеТекста.Закрыть();

	Возврат Результат;

КонецФункции

#КонецОбласти
