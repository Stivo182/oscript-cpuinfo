#Использовать 1commands
#Использовать logos

Перем _Лог; // Лог

#Область ОбработчикиСобытий

// Определяет характеристики процессора в Windows через COM WMI
// с резервным переходом на PowerShell CIM.
Процедура ПриСозданииОбъекта()

	_Лог = Логирование.ПолучитьЛог("oscript.lib.cpuinfo.windows.detector");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет доступность детектора на текущей платформе.
//
// Возвращаемое значение:
//   Булево - Истина, если текущая платформа Windows.
Функция Доступен() Экспорт

	Тип = Новый СистемнаяИнформация().ТипПлатформы;
	Возврат Тип = ТипПлатформы.Windows_x86 Или Тип = ТипПлатформы.Windows_x86_64;

КонецФункции

// Определяет характеристики процессора через COM WMI с резервным переходом на PowerShell CIM.
//
// Возвращаемое значение:
//   ИнформацияОПроцессоре - определенные характеристики процессора.
//
// Исключения:
//   Детектор доступен только на Windows - если текущая платформа не Windows.
//   Не удалось получить информацию о процессоре - если COM WMI и PowerShell CIM завершились неудачно.
Функция Определить() Экспорт

	Если Не Доступен() Тогда
		ВызватьИсключение "Детектор доступен только на Windows";
	КонецЕсли;

	_Лог.Отладка("Получение информации о процессоре через COM WMI");

	ПричинаОшибкиWmi = "";
	ИнформацияОПроцессоре = ПолучитьЧерезComWmi(ПричинаОшибкиWmi);
	Если ИнформацияЗаполнена(ИнформацияОПроцессоре) Тогда
		_Лог.Отладка("Информация о процессоре получена через COM WMI");
		Возврат ИнформацияОПроцессоре;
	КонецЕсли;

	_Лог.Предупреждение(
		"Не удалось получить информацию о процессоре через COM WMI: %1",
		ПричинаОшибкиWmi
	);

	_Лог.Отладка("Получение информации о процессоре через PowerShell CIM");

	ПричинаОшибкиCim = "";
	ИнформацияОПроцессоре = ПолучитьЧерезPowerShellCim(ПричинаОшибкиCim);
	Если ИнформацияЗаполнена(ИнформацияОПроцессоре) Тогда
		_Лог.Отладка("Информация о процессоре получена через PowerShell CIM");
		Возврат ИнформацияОПроцессоре;
	КонецЕсли;

	ТекстОшибки = СтрШаблон(
		"Не удалось получить информацию о процессоре. COM WMI: %1; PowerShell CIM: %2",
		ПричинаОшибкиWmi,
		ПричинаОшибкиCim
	);

	_Лог.Ошибка(ТекстОшибки);

	ВызватьИсключение ТекстОшибки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЧерезComWmi(ПричинаОшибки)

	Попытка
		ДанныеПроцессоров = ПолучитьДанныеЧерезComWmi();
		ИнформацияОПроцессоре = Новый ПреобразовательДанныхПроцессораWindows().Преобразовать(ДанныеПроцессоров);
	Исключение
		ПричинаОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Если Не ИнформацияЗаполнена(ИнформацияОПроцессоре) Тогда
		ПричинаОшибки = "результат не содержит обязательные сведения о процессоре";
		Возврат Неопределено;
	КонецЕсли;

	Возврат ИнформацияОПроцессоре;

КонецФункции

Функция ПолучитьДанныеЧерезComWmi()

	ЛокаторWmi = Новый COMОбъект("WbemScripting.SWbemLocator");
	СлужбаWmi = ЛокаторWmi.ConnectServer(".", "root\cimv2");
	ЭкземплярыПроцессоров = СлужбаWmi.ExecQuery(
		"SELECT Architecture, Name, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed FROM Win32_Processor"
	);

	ДанныеПроцессоров = Новый Массив();
	Для Каждого ЭкземплярПроцессора Из ЭкземплярыПроцессоров Цикл
		ДанныеПроцессора = НовыеДанныеПроцессора(
			ЭкземплярПроцессора.Name,
			ЭкземплярПроцессора.Architecture,
			ЭкземплярПроцессора.NumberOfCores,
			ЭкземплярПроцессора.NumberOfLogicalProcessors,
			ЭкземплярПроцессора.MaxClockSpeed
		);
		ДанныеПроцессоров.Добавить(ДанныеПроцессора);
	КонецЦикла;

	Возврат ДанныеПроцессоров;

КонецФункции

Функция ПолучитьЧерезPowerShellCim(ПричинаОшибки)

	Попытка
		Команда = КомандаPowerShellCim();
		Команда.Исполнить();
		ДанныеПроцессоров = ПрочитатьДанныеPowerShellCim(Команда.ПолучитьВывод());
		ИнформацияОПроцессоре = Новый ПреобразовательДанныхПроцессораWindows().Преобразовать(ДанныеПроцессоров);
	Исключение
		ПричинаОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Если Не ИнформацияЗаполнена(ИнформацияОПроцессоре) Тогда
		ПричинаОшибки = "результат не содержит обязательные сведения о процессоре";
		Возврат Неопределено;
	КонецЕсли;

	Возврат ИнформацияОПроцессоре;

КонецФункции

Функция КомандаPowerShellCim()

	ПутьКPowerShell = ПолучитьПеременнуюСреды("SystemRoot")
		+ "\System32\WindowsPowerShell\v1.0\powershell.exe";

	Сценарий = "Get-CimInstance Win32_Processor -ErrorAction Stop"
		+ " | Select-Object Architecture, Name, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed"
		+ " | ConvertTo-Json -Compress";

	Команда = Новый Команда;
	Команда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
	Команда.УстановитьПравильныйКодВозврата(0);
	Команда.УстановитьКоманду(ПутьКPowerShell);
	Команда.ДобавитьПараметр("-NoProfile");
	Команда.ДобавитьПараметр("-NonInteractive");
	Команда.ДобавитьПараметр("-Command");
	Команда.ДобавитьПараметр("""" + Сценарий + """");

	Возврат Команда;

КонецФункции

Функция ПрочитатьДанныеPowerShellCim(ТекстJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	ПрочитанныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(ПрочитанныеДанные) = Тип("Массив") Тогда
		ЭкземплярыПроцессоров = ПрочитанныеДанные;
	Иначе
		ЭкземплярыПроцессоров = Новый Массив();
		ЭкземплярыПроцессоров.Добавить(ПрочитанныеДанные);
	КонецЕсли;

	ДанныеПроцессоров = Новый Массив();
	Для Каждого ЭкземплярПроцессора Из ЭкземплярыПроцессоров Цикл
		ДанныеПроцессора = НовыеДанныеПроцессора(
			ЭкземплярПроцессора["Name"],
			ЭкземплярПроцессора["Architecture"],
			ЭкземплярПроцессора["NumberOfCores"],
			ЭкземплярПроцессора["NumberOfLogicalProcessors"],
			ЭкземплярПроцессора["MaxClockSpeed"]
		);
		ДанныеПроцессоров.Добавить(ДанныеПроцессора);
	КонецЦикла;

	Возврат ДанныеПроцессоров;

КонецФункции

Функция НовыеДанныеПроцессора(
		Имя,
		КодАрхитектуры,
		КоличествоЯдер,
		КоличествоЛогическихПроцессоров,
		МаксимальнаяЧастотаМГц)

	Возврат Новый Структура(
		"Имя, КодАрхитектуры, КоличествоЯдер, КоличествоЛогическихПроцессоров, МаксимальнаяЧастотаМГц",
		Имя,
		КодАрхитектуры,
		КоличествоЯдер,
		КоличествоЛогическихПроцессоров,
		МаксимальнаяЧастотаМГц);

КонецФункции

Функция ИнформацияЗаполнена(ИнформацияОПроцессоре)

	Возврат ИнформацияОПроцессоре <> Неопределено
		И ЗначениеЗаполнено(ИнформацияОПроцессоре.ИмяПроцессора)
		И ИнформацияОПроцессоре.КоличествоПроцессоров > 0
		И ИнформацияОПроцессоре.КоличествоЯдер > 0
		И ИнформацияОПроцессоре.КоличествоЛогическихПроцессоров > 0
		И ЗначениеЗаполнено(ИнформацияОПроцессоре.Архитектура);

КонецФункции

#КонецОбласти
