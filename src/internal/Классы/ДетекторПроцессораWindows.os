#Область ПрограммныйИнтерфейс

// Проверяет доступность детектора на текущей платформе.
//
// Возвращаемое значение:
//   Булево - Истина, если текущая платформа Windows.
Функция Доступен() Экспорт

	Тип = Новый СистемнаяИнформация().ТипПлатформы;
	Возврат Тип = ТипПлатформы.Windows_x86 Или Тип = ТипПлатформы.Windows_x86_64;

КонецФункции

// Определяет характеристики процессора через WMIC с резервным переходом на CIM.
//
// Возвращаемое значение:
//   ИнформацияОПроцессоре - определенные характеристики процессора.
//
// Исключения:
//   Детектор доступен только на Windows - если текущая платформа не Windows.
//   Не удалось получить информацию о процессоре - если WMIC и CIM завершились неудачно.
Функция Определить() Экспорт

	Если Не Доступен() Тогда
		ВызватьИсключение "Детектор доступен только на Windows";
	КонецЕсли;

	ИсточникWmic = Новый ИсточникИнформацииОПроцессореWmic();
	ИсточникCim = Новый ИсточникИнформацииОПроцессореCim();
	Определитель = Новый ОпределительИнформацииОПроцессореWindows();

	Возврат Определитель.Определить(ИсточникWmic, ИсточникCim);

КонецФункции

#КонецОбласти
