// BSLLS:LatinAndCyrillicSymbolInWord-off

#Использовать logos

Перем _Лог; // Лог
Перем _ТипПлатформы; // ТипПлатформы
Перем _ИсточникComWmi; // ИсточникИнформацииОПроцессореComWmi
Перем _ИсточникWmic; // ИсточникИнформацииОПроцессореWmic
Перем _ИсточникPowerShellCim; // ИсточникИнформацииОПроцессореPowerShellCim

#Область ОбработчикиСобытий

// Определяет характеристики процессора в Windows через COM WMI
// с резервным переходом на WMIC и PowerShell CIM.
Процедура ПриСозданииОбъекта()

	_Лог = Логирование.ПолучитьЛог("oscript.lib.cpuinfo.windows.detector");
	_ТипПлатформы = Новый СистемнаяИнформация().ТипПлатформы;
	_ИсточникComWmi = Новый ИсточникИнформацииОПроцессореComWmi();
	_ИсточникWmic = Новый ИсточникИнформацииОПроцессореWmic();
	_ИсточникPowerShellCim = Новый ИсточникИнформацииОПроцессореPowerShellCim();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет доступность детектора на текущей платформе.
//
// Возвращаемое значение:
//   Булево - Истина, если текущая платформа Windows.
Функция Доступен() Экспорт

	Возврат _ТипПлатформы = ТипПлатформы.Windows_x86
		Или _ТипПлатформы = ТипПлатформы.Windows_x86_64;

КонецФункции

// Определяет характеристики процессора через COM WMI с резервным переходом на WMIC и PowerShell CIM.
//
// Возвращаемое значение:
//   ИнформацияОПроцессоре - определенные характеристики процессора.
//
// Исключения:
//   Детектор доступен только на Windows - если текущая платформа не Windows.
//   Не удалось получить информацию о процессоре - если COM WMI, WMIC и PowerShell CIM завершились неудачно.
Функция Определить() Экспорт

	Если Не Доступен() Тогда
		ВызватьИсключение "Детектор доступен только на Windows";
	КонецЕсли;

	_Лог.Отладка("Получение информации о процессоре через COM WMI");

	Попытка
		ИнформацияОПроцессоре = ПреобразоватьДанныеПроцессоров(_ИсточникComWmi.Получить());
		_Лог.Отладка("Информация о процессоре получена через COM WMI");
		Возврат ИнформацияОПроцессоре;
	Исключение
		ПричинаОшибкиComWmi = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	_Лог.Предупреждение(
		"Не удалось получить информацию о процессоре через COM WMI: %1",
		ПричинаОшибкиComWmi
	);

	_Лог.Отладка("Получение информации о процессоре через WMIC");

	Попытка
		ИнформацияОПроцессоре = ПреобразоватьДанныеПроцессоров(_ИсточникWmic.Получить());
		_Лог.Отладка("Информация о процессоре получена через WMIC");
		Возврат ИнформацияОПроцессоре;
	Исключение
		ПричинаОшибкиWmic = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	_Лог.Предупреждение(
		"Не удалось получить информацию о процессоре через WMIC: %1",
		ПричинаОшибкиWmic
	);

	_Лог.Отладка("Получение информации о процессоре через PowerShell CIM");

	Попытка
		ИнформацияОПроцессоре = ПреобразоватьДанныеПроцессоров(_ИсточникPowerShellCim.Получить());
		_Лог.Отладка("Информация о процессоре получена через PowerShell CIM");
		Возврат ИнформацияОПроцессоре;
	Исключение
		ПричинаОшибкиCim = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ТекстОшибки = СтрШаблон(
		"Не удалось получить информацию о процессоре. COM WMI: %1; WMIC: %2; PowerShell CIM: %3",
		ПричинаОшибкиComWmi,
		ПричинаОшибкиWmic,
		ПричинаОшибкиCim
	);

	_Лог.Ошибка(ТекстОшибки);

	ВызватьИсключение ТекстОшибки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПреобразоватьДанныеПроцессоров(ДанныеПроцессоров)

	Возврат Новый ПреобразовательДанныхПроцессораWindows().Преобразовать(ДанныеПроцессоров);

КонецФункции

#КонецОбласти
