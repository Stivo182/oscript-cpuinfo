Перем _РегулярноеВыражениеЧастоты; // РегулярноеВыражение

#Область ПрограммныйИнтерфейс

// Внутренний парсер информации о процессоре Linux из фактов /proc/cpuinfo и lscpu.

// Формирует информацию о процессоре Linux из фактов /proc/cpuinfo и lscpu.
//
// Параметры:
//   Cpuinfo - Строка - содержимое файла /proc/cpuinfo.
//   Lscpu - Строка - вывод команды lscpu.
//
// Возвращаемое значение:
//   ИнформацияОПроцессоре - объединенная информация о процессоре.
Функция Распарсить(Cpuinfo, Lscpu) Экспорт

	ПарсерCpuInfo = Новый ПарсерДанныхПроцессораCpuInfo();
	ПарсерLscpu = Новый ПарсерДанныхПроцессораLscpu();
	ФактыCpuInfo = ПарсерCpuInfo.Распарсить(Cpuinfo);
	ФактыLscpu = ПарсерLscpu.Распарсить(Lscpu);

	ИнформацияОПроцессоре = Новый ИнформацияОПроцессоре(Ложь);
	ИменаМоделей = ОбъединитьИменаМоделей(ФактыCpuInfo, ФактыLscpu);

	ЗаполнитьТопологию(ИнформацияОПроцессоре, ФактыCpuInfo, ФактыLscpu);
	ЗаполнитьЧастоты(ИнформацияОПроцессоре, ИменаМоделей, ФактыCpuInfo, ФактыLscpu);

	ИнформацияОПроцессоре.ИмяПроцессора = СтрСоединить(ИменаМоделей, ", ");
	ИнформацияОПроцессоре.Архитектура = ФактыLscpu.Архитектура;

	Возврат ИнформацияОПроцессоре;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает уникальные имена моделей, используя Processor и Hardware как общий резерв.
//
// Параметры:
//   ФактыCpuInfo - Структура - факты из /proc/cpuinfo.
//   ФактыLscpu - Структура - факты из lscpu.
//
// Возвращаемое значение:
//   Массив из Строка - уникальные имена моделей процессоров.
Функция ОбъединитьИменаМоделей(ФактыCpuInfo, ФактыLscpu)

	ИменаМоделей = Новый Массив();

	Для Каждого ИмяМодели Из ФактыCpuInfo.ИменаМоделей Цикл
		ДобавитьУникальноеИмяМодели(ИменаМоделей, ИмяМодели);
	КонецЦикла;

	ДобавитьУникальноеИмяМодели(ИменаМоделей, ФактыLscpu.ИмяМодели);

	Если ИменаМоделей.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(ФактыCpuInfo.ИмяПроцессора) Тогда
			ИменаМоделей.Добавить(ФактыCpuInfo.ИмяПроцессора);
		ИначеЕсли ЗначениеЗаполнено(ФактыCpuInfo.Оборудование) Тогда
			ИменаМоделей.Добавить(ФактыCpuInfo.Оборудование);
		КонецЕсли;
	КонецЕсли;

	Возврат ИменаМоделей;

КонецФункции

// Добавляет непустое имя модели в массив, если такого имени еще нет.
//
// Параметры:
//   ИменаМоделей - Массив из Строка - накопленные имена моделей.
//   ИмяМодели - Строка - добавляемое имя модели.
Процедура ДобавитьУникальноеИмяМодели(ИменаМоделей, ИмяМодели)

	Если ЗначениеЗаполнено(ИмяМодели)
		И ИменаМоделей.Найти(ИмяМодели) = Неопределено Тогда
		ИменаМоделей.Добавить(ИмяМодели);
	КонецЕсли;

КонецПроцедуры

// Заполняет сведения о процессорах, физических ядрах и логических процессорах.
//
// Параметры:
//   ИнформацияОПроцессоре - ИнформацияОПроцессоре - заполняемая информация.
//   ФактыCpuInfo - Структура - факты из /proc/cpuinfo.
//   ФактыLscpu - Структура - факты из lscpu.
Процедура ЗаполнитьТопологию(ИнформацияОПроцессоре, ФактыCpuInfo, ФактыLscpu)

	Если ФактыCpuInfo.КоличествоЛогическихПроцессоров > 0 Тогда
		ИнформацияОПроцессоре.КоличествоЛогическихПроцессоров =
			ФактыCpuInfo.КоличествоЛогическихПроцессоров;
	Иначе
		ИнформацияОПроцессоре.КоличествоЛогическихПроцессоров =
			ФактыLscpu.КоличествоЛогическихПроцессоров;
	КонецЕсли;

	Если ФактыCpuInfo.КоличествоПроцессоров > 0 Тогда
		ИнформацияОПроцессоре.КоличествоПроцессоров = ФактыCpuInfo.КоличествоПроцессоров;
	Иначе
		ИнформацияОПроцессоре.КоличествоПроцессоров = ФактыLscpu.КоличествоПроцессоров;
	КонецЕсли;

	ИнформацияОПроцессоре.КоличествоЯдер = ПолучитьКоличествоЯдер(
		ФактыCpuInfo,
		ФактыLscpu,
		ИнформацияОПроцессоре.КоличествоПроцессоров);

	Если ИнформацияОПроцессоре.КоличествоПроцессоров = 0
		И (ИнформацияОПроцессоре.КоличествоЛогическихПроцессоров > 0
			Или ИнформацияОПроцессоре.КоличествоЯдер > 0) Тогда
		ИнформацияОПроцессоре.КоличествоПроцессоров = 1;
	КонецЕсли;

КонецПроцедуры

// Выбирает наиболее точные доступные сведения о физических ядрах.
//
// Параметры:
//   ФактыCpuInfo - Структура - факты из /proc/cpuinfo.
//   ФактыLscpu - Структура - факты из lscpu.
//   КоличествоПроцессоров - Число - определенное количество физических процессоров.
//
// Возвращаемое значение:
//   Число - суммарное количество физических ядер.
Функция ПолучитьКоличествоЯдер(ФактыCpuInfo, ФактыLscpu, КоличествоПроцессоров)

	КоличествоЯдер = ФактыCpuInfo.КоличествоЯдерПоИдентификаторам.Количество();
	Если КоличествоЯдер > 0 Тогда
		Возврат КоличествоЯдер;
	КонецЕсли;

	Для Каждого Строка Из ФактыCpuInfo.КоличествоЯдерПоПроцессорам Цикл
		КоличествоЯдер = КоличествоЯдер + Строка.Значение;
	КонецЦикла;

	Если КоличествоЯдер > 0 Тогда
		Возврат КоличествоЯдер;
	КонецЕсли;

	КоличествоПроцессоровДляРасчета = ?(КоличествоПроцессоров > 0, КоличествоПроцессоров, 1);

	Возврат ФактыLscpu.КоличествоЯдерВСокете * КоличествоПроцессоровДляРасчета;

КонецФункции

// Заполняет максимальную и номинальную частоты процессора.
//
// Параметры:
//   ИнформацияОПроцессоре - ИнформацияОПроцессоре - заполняемая информация.
//   ИменаМоделей - Массив из Строка - имена моделей процессоров.
//   ФактыCpuInfo - Структура - факты из /proc/cpuinfo.
//   ФактыLscpu - Структура - факты из lscpu.
Процедура ЗаполнитьЧастоты(ИнформацияОПроцессоре, ИменаМоделей, ФактыCpuInfo, ФактыLscpu)

	Если ФактыCpuInfo.МаксимальнаяЧастота > 0 Тогда
		ИнформацияОПроцессоре.МаксимальнаяЧастота = ФактыCpuInfo.МаксимальнаяЧастота;
	Иначе
		ИнформацияОПроцессоре.МаксимальнаяЧастота = ФактыLscpu.МаксимальнаяЧастота;
	КонецЕсли;

	НоминальнаяЧастота = ПолучитьЧастотуИзСпискаМоделей(ИменаМоделей);
	Если НоминальнаяЧастота = 0 Тогда
		НоминальнаяЧастота = ИнформацияОПроцессоре.МаксимальнаяЧастота;
	КонецЕсли;

	ИнформацияОПроцессоре.НоминальнаяЧастота = НоминальнаяЧастота;

КонецПроцедуры

// Получает первую указанную в именах моделей номинальную частоту.
//
// Параметры:
//   Модели - Массив из Строка - имена моделей процессоров.
//
// Возвращаемое значение:
//   Число - частота в герцах или 0, если частота не найдена.
Функция ПолучитьЧастотуИзСпискаМоделей(Модели)

	Для Каждого Модель Из Модели Цикл

		Частота = ПолучитьЧастотуИзСтрокиМодели(Модель);

		Если Частота > 0 Тогда
			Возврат Частота;
		КонецЕсли;

	КонецЦикла;

	Возврат 0;

КонецФункции

// Извлекает номинальную частоту из имени модели процессора.
//
// Параметры:
//   СтрокаМодели - Строка - имя модели процессора.
//
// Возвращаемое значение:
//   Число - частота в герцах или 0, если частота не найдена.
Функция ПолучитьЧастотуИзСтрокиМодели(СтрокаМодели)

	Частота = 0;

	Совпадения = РегулярноеВыражениеЧастоты().НайтиСовпадения(СтрокаМодели);
	Если Совпадения.Количество() > 0 И Совпадения[0].Группы.Количество() > 1 Тогда
		Частота = КонвертацияЗначенийCpuInfo.СтрокаВЧисло(Совпадения[0].Группы[1].Значение);
		Частота = КонвертацияЗначенийCpuInfo.ГигагерцыВГерцы(Частота);
	КонецЕсли;

	Возврат Частота;

КонецФункции

Функция РегулярноеВыражениеЧастоты()

	Если _РегулярноеВыражениеЧастоты = Неопределено Тогда
		_РегулярноеВыражениеЧастоты = Новый РегулярноеВыражение("(\d.\d+)GHz");
		_РегулярноеВыражениеЧастоты.ИгнорироватьРегистр = Истина;
	КонецЕсли;

	Возврат _РегулярноеВыражениеЧастоты;

КонецФункции

#КонецОбласти
