#Использовать 1commands

#Область ПрограммныйИнтерфейс

// Получает сведения о процессоре через lscpu в нейтральной локали.
//
// Возвращаемое значение:
//   Строка - вывод команды lscpu.
Функция Получить() Экспорт

	Команда = Новый Команда;
	Команда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
	Команда.УстановитьПравильныйКодВозврата(0);
	Команда.УстановитьПеременныеСреды(ПеременныеСредыLscpu());
	Команда.УстановитьКоманду("lscpu");
	Команда.Исполнить();

	Возврат Команда.ПолучитьВывод();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПеременныеСредыLscpu()

	Результат = ПеременныеСреды();
	Результат.Вставить("LC_ALL", "C");

	Возврат Результат;

КонецФункции

#КонецОбласти
