#Использовать 1commands
#Использовать fs

#Область ПрограммныйИнтерфейс

// Получает записи Win32_Processor через WMIC.
//
// Возвращаемое значение:
//   Массив из Соответствие - записи Win32_Processor:
//     * Name - Строка - имя процессора;
//     * Architecture - Строка, Число - код архитектуры процессора;
//     * NumberOfCores - Строка, Число - количество физических ядер;
//     * NumberOfLogicalProcessors - Строка, Число - количество логических процессоров;
//     * MaxClockSpeed - Строка, Число - максимальная частота в мегагерцах, 0 если неизвестна.
Функция Получить() Экспорт

	Команда = КомандаWmic();
	Команда.Исполнить();

	Возврат ПарсерДанныхПроцессораWmic.Распарсить(Команда.ПолучитьВывод());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомандаWmic()

	ПутьКWmic = ПолучитьПеременнуюСреды("SystemRoot")
		+ "\System32\wbem\WMIC.exe";

	Команда = Новый Команда;
	Команда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
	Команда.УстановитьПравильныйКодВозврата(0);

	Если ФС.ФайлСуществует(ПутьКWmic) Тогда
		Команда.УстановитьКоманду(ПутьКWmic);
	Иначе
		Команда.УстановитьКоманду("wmic");
	КонецЕсли;

	Команда.ДобавитьПараметр(
		"cpu get Architecture, Name, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed /Format:List");

	Возврат Команда;

КонецФункции

#КонецОбласти
