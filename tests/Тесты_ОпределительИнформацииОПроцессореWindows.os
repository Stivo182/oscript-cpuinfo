#Использовать "helpers"

#Область Тесты

&Тест
Процедура ТестДолжен_ИспользоватьCimПослеОшибкиWmic() Экспорт

	// Подготовка
	КомандаWmic = Новый ИмитацияКомандыПолученияИнформацииОПроцессореWindows("", "Ошибка WMIC");
	КомандаCim = Новый ИмитацияКомандыПолученияИнформацииОПроцессореWindows(КорректныйВыводCim("CIM CPU"));
	Определитель = Новый ОпределительИнформацииОПроцессореWindows();

	// Действие
	ИнформацияОПроцессоре = Определитель.Определить(КомандаWmic, КомандаCim);

	// Проверка
	Ожидаем.Что(ИнформацияОПроцессоре.ИмяПроцессора).Равно("CIM CPU");
	Ожидаем.Что(КомандаWmic.КоличествоВызовов).Равно(1);
	Ожидаем.Что(КомандаCim.КоличествоВызовов).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВызыватьCimПриУспешномWmic() Экспорт

	// Подготовка
	КомандаWmic = Новый ИмитацияКомандыПолученияИнформацииОПроцессореWindows(
		КорректныйВыводWmic("WMIC CPU"));
	КомандаCim = Новый ИмитацияКомандыПолученияИнформацииОПроцессореWindows("", "CIM не должен вызываться");
	Определитель = Новый ОпределительИнформацииОПроцессореWindows();

	// Действие
	ИнформацияОПроцессоре = Определитель.Определить(КомандаWmic, КомандаCim);

	// Проверка
	Ожидаем.Что(ИнформацияОПроцессоре.ИмяПроцессора).Равно("WMIC CPU");
	Ожидаем.Что(КомандаWmic.КоличествоВызовов).Равно(1);
	Ожидаем.Что(КомандаCim.КоличествоВызовов).Равно(0);

КонецПроцедуры

&Тест
&Параметры("Пустой")
&Параметры("ТолькоИмя")
&Параметры("БезАрхитектуры")
Процедура ТестДолжен_ИспользоватьCimПослеНеполногоWmic(ВариантВыводаWmic) Экспорт

	// Подготовка
	КомандаWmic = Новый ИмитацияКомандыПолученияИнформацииОПроцессореWindows(
		НеполныйВыводWmic(ВариантВыводаWmic));
	КомандаCim = Новый ИмитацияКомандыПолученияИнформацииОПроцессореWindows(КорректныйВыводCim("CIM CPU"));
	Определитель = Новый ОпределительИнформацииОПроцессореWindows();

	// Действие
	ИнформацияОПроцессоре = Определитель.Определить(КомандаWmic, КомандаCim);

	// Проверка
	Ожидаем.Что(ИнформацияОПроцессоре.ИмяПроцессора).Равно("CIM CPU");
	Ожидаем.Что(КомандаCim.КоличествоВызовов).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщатьПричиныОшибокWmicИCim() Экспорт

	// Подготовка
	КомандаWmic = Новый ИмитацияКомандыПолученияИнформацииОПроцессореWindows("", "Ошибка WMIC");
	КомандаCim = Новый ИмитацияКомандыПолученияИнформацииОПроцессореWindows("", "Ошибка CIM");
	Определитель = Новый ОпределительИнформацииОПроцессореWindows();
	ТекстИсключения = "";

	// Действие
	Попытка
		Определитель.Определить(КомандаWmic, КомандаCim);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ТекстИсключения).Содержит("WMIC: Ошибка WMIC");
	Ожидаем.Что(ТекстИсключения).Содержит("CIM: Ошибка CIM");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КорректныйВыводWmic(ИмяПроцессора)

	Возврат СтрШаблон("Architecture=9
		|MaxClockSpeed=3000
		|Name=%1
		|NumberOfCores=4
		|NumberOfLogicalProcessors=8", ИмяПроцессора);

КонецФункции

Функция КорректныйВыводCim(ИмяПроцессора)

	Возврат СтрШаблон("Architecture : 9
		|MaxClockSpeed : 3000
		|Name : %1
		|NumberOfCores : 4
		|NumberOfLogicalProcessors : 8", ИмяПроцессора);

КонецФункции

Функция НеполныйВыводWmic(ВариантВывода)

	Если ВариантВывода = "Пустой" Тогда
		Возврат "";
	ИначеЕсли ВариантВывода = "ТолькоИмя" Тогда
		Возврат "Name=Неполный результат WMIC";
	ИначеЕсли ВариантВывода = "БезАрхитектуры" Тогда
		Возврат "MaxClockSpeed=3000
			|Name=WMIC без архитектуры
			|NumberOfCores=4
			|NumberOfLogicalProcessors=8";
	КонецЕсли;

	ВызватьИсключение "Неизвестный вариант вывода WMIC: " + ВариантВывода;

КонецФункции

#КонецОбласти
