#Использовать "helpers"

#Область Тесты

&Тест
Процедура ТестДолжен_ИспользоватьCimПослеОшибкиWmic() Экспорт

	// Подготовка
	ИсточникWmic = Новый ИмитацияИсточникаИнформацииОПроцессореWindows(Неопределено, "Ошибка WMIC");
	ИсточникCim = Новый ИмитацияИсточникаИнформацииОПроцессореWindows(КорректнаяИнформация("CIM CPU"));
	Определитель = Новый ОпределительИнформацииОПроцессореWindows();

	// Действие
	ИнформацияОПроцессоре = Определитель.Определить(ИсточникWmic, ИсточникCim);

	// Проверка
	Ожидаем.Что(ИнформацияОПроцессоре.ИмяПроцессора).Равно("CIM CPU");
	Ожидаем.Что(ИсточникWmic.КоличествоВызовов).Равно(1);
	Ожидаем.Что(ИсточникCim.КоличествоВызовов).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВызыватьCimПриУспешномWmic() Экспорт

	// Подготовка
	ИсточникWmic = Новый ИмитацияИсточникаИнформацииОПроцессореWindows(КорректнаяИнформация("WMIC CPU"));
	ИсточникCim = Новый ИмитацияИсточникаИнформацииОПроцессореWindows(Неопределено, "CIM не должен вызываться");
	Определитель = Новый ОпределительИнформацииОПроцессореWindows();

	// Действие
	ИнформацияОПроцессоре = Определитель.Определить(ИсточникWmic, ИсточникCim);

	// Проверка
	Ожидаем.Что(ИнформацияОПроцессоре.ИмяПроцессора).Равно("WMIC CPU");
	Ожидаем.Что(ИсточникWmic.КоличествоВызовов).Равно(1);
	Ожидаем.Что(ИсточникCim.КоличествоВызовов).Равно(0);

КонецПроцедуры

&Тест
&Параметры("Пустой")
&Параметры("ТолькоИмя")
&Параметры("БезАрхитектуры")
Процедура ТестДолжен_ИспользоватьCimПослеНеполногоWmic(ВариантИнформацииWmic) Экспорт

	// Подготовка
	ИсточникWmic = Новый ИмитацияИсточникаИнформацииОПроцессореWindows(
		НеполнаяИнформация(ВариантИнформацииWmic));
	ИсточникCim = Новый ИмитацияИсточникаИнформацииОПроцессореWindows(КорректнаяИнформация("CIM CPU"));
	Определитель = Новый ОпределительИнформацииОПроцессореWindows();

	// Действие
	ИнформацияОПроцессоре = Определитель.Определить(ИсточникWmic, ИсточникCim);

	// Проверка
	Ожидаем.Что(ИнформацияОПроцессоре.ИмяПроцессора).Равно("CIM CPU");
	Ожидаем.Что(ИсточникCim.КоличествоВызовов).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщатьПричиныОшибокWmicИCim() Экспорт

	// Подготовка
	ИсточникWmic = Новый ИмитацияИсточникаИнформацииОПроцессореWindows(Неопределено, "Ошибка WMIC");
	ИсточникCim = Новый ИмитацияИсточникаИнформацииОПроцессореWindows(Неопределено, "Ошибка CIM");
	Определитель = Новый ОпределительИнформацииОПроцессореWindows();
	ТекстИсключения = "";

	// Действие
	Попытка
		Определитель.Определить(ИсточникWmic, ИсточникCim);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ТекстИсключения).Содержит("WMIC: Ошибка WMIC");
	Ожидаем.Что(ТекстИсключения).Содержит("CIM: Ошибка CIM");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КорректнаяИнформация(ИмяПроцессора)

	Информация = Новый ИнформацияОПроцессоре(Ложь);
	Информация.ИмяПроцессора = ИмяПроцессора;
	Информация.КоличествоПроцессоров = 1;
	Информация.КоличествоЯдер = 4;
	Информация.КоличествоЛогическихПроцессоров = 8;
	Информация.Архитектура = АрхитектурыПроцессоров.X64;

	Возврат Информация;

КонецФункции

Функция НеполнаяИнформация(ВариантИнформации)

	Информация = Новый ИнформацияОПроцессоре(Ложь);
	Если ВариантИнформации = "Пустой" Тогда
		Возврат Информация;
	ИначеЕсли ВариантИнформации = "ТолькоИмя" Тогда
		Информация.ИмяПроцессора = "Неполный результат WMIC";
		Возврат Информация;
	ИначеЕсли ВариантИнформации = "БезАрхитектуры" Тогда
		Информация.ИмяПроцессора = "WMIC без архитектуры";
		Информация.КоличествоПроцессоров = 1;
		Информация.КоличествоЯдер = 4;
		Информация.КоличествоЛогическихПроцессоров = 8;
		Возврат Информация;
	КонецЕсли;

	ВызватьИсключение "Неизвестный вариант информации WMIC: " + ВариантИнформации;

КонецФункции

#КонецОбласти
