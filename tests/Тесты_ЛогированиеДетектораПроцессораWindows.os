#Использовать "helpers"
#Использовать logos

#Область Тесты

&Тест
Процедура ТестДолжен_ЗаписыватьИспользованиеComWmiВЛог() Экспорт

	// Подготовка
	Детектор = Новый ДетекторПроцессораWindows();
	Если Не Детектор.Доступен() Тогда
		Возврат;
	КонецЕсли;
	Лог = Логирование.ПолучитьЛог("oscript.lib.cpuinfo.windows.detector");
	Накопитель = Новый НакопительСообщенийЛога();
	Лог.ДобавитьСпособВывода(Накопитель, УровниЛога.Отладка);

	// Действие
	Попытка
		Детектор.Определить();
	Исключение
	КонецПопытки;
	Сообщения = Накопитель.ПолучитьСообщения();
	Уровни = Накопитель.ПолучитьУровни();
	Лог.УдалитьСпособВывода(Накопитель);

	// Проверка
	Ожидаем.Что(СтрСоединить(Сообщения, Символы.ПС))
		.Содержит("Получение информации о процессоре через COM WMI");
	Ожидаем.Что(Уровни[0]).Равно(УровниЛога.Отладка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьУровниПредупреждениеИОшибкаПриОтказеИсточниковWindows() Экспорт

	// Подготовка
	ПутьКДетектору = "src\internal\Классы\ДетекторПроцессораWindows.os";

	// Действие
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКДетектору, КодировкаТекста.UTF8);
	ТекстДетектора = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	// Проверка
	Ожидаем.Что(ТекстДетектора).Содержит("_Лог.Предупреждение(");
	Ожидаем.Что(ТекстДетектора).Содержит("_Лог.Ошибка(");

КонецПроцедуры

#КонецОбласти
