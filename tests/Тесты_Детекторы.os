#Использовать "helpers"

&Тест
Процедура ТестДолжен_ПолучатьДанныеИзИсточниковLinux() Экспорт

	// Подготовка
	Вызовы = Новый Массив();
	CpuInfo = "processor: 0
	|model name: Тестовый CPU @ 2.00GHz
	|physical id: 0
	|core id: 0
	|cpu cores: 1
	|max freq: 2200";
	Lscpu = "Architecture: x86_64
	|CPU(s): 1
	|Socket(s): 1
	|Core(s) per socket: 1";
	Детектор = НастроенныйДетекторLinux(
		Новый МокИсточникИнформацииОПроцессоре("cpuinfo", Вызовы, CpuInfo),
		Новый МокИсточникИнформацииОПроцессоре("lscpu", Вызовы, Lscpu));

	// Действие
	Информация = Детектор.Определить();

	// Проверка
	Ожидаем.Что(Информация.ИмяПроцессора).Равно("Тестовый CPU @ 2.00GHz");
	Ожидаем.Что(Информация.КоличествоПроцессоров).Равно(1);
	Ожидаем.Что(Информация.КоличествоЯдер).Равно(1);
	Ожидаем.Что(Информация.КоличествоЛогическихПроцессоров).Равно(1);
	Ожидаем.Что(Информация.МаксимальнаяЧастота).Равно(2200000000);
	Ожидаем.Что(Информация.Архитектура).Равно(АрхитектурыПроцессоров.X64);
	Ожидаем.Что(СтрСоединить(Вызовы, ", ")).Равно("cpuinfo, lscpu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВызыватьLscpuПриОшибкеCpuInfo() Экспорт

	// Подготовка
	Вызовы = Новый Массив();
	Детектор = НастроенныйДетекторLinux(
		Новый МокИсточникИнформацииОПроцессоре("cpuinfo", Вызовы, , "Ошибка cpuinfo"),
		Новый МокИсточникИнформацииОПроцессоре("lscpu", Вызовы, , "lscpu не должен вызываться"));
	ТекстОшибки = "";

	// Действие
	Попытка
		Детектор.Определить();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ТекстОшибки).Содержит("Ошибка cpuinfo");
	Ожидаем.Что(СтрСоединить(Вызовы, ", ")).Равно("cpuinfo");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередаватьОшибкуLscpu() Экспорт

	// Подготовка
	Вызовы = Новый Массив();
	Детектор = НастроенныйДетекторLinux(
		Новый МокИсточникИнформацииОПроцессоре("cpuinfo", Вызовы, "processor: 0"),
		Новый МокИсточникИнформацииОПроцессоре("lscpu", Вызовы, , "Ошибка lscpu"));
	ТекстОшибки = "";

	// Действие
	Попытка
		Детектор.Определить();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ТекстОшибки).Содержит("Ошибка lscpu");
	Ожидаем.Что(СтрСоединить(Вызовы, ", ")).Равно("cpuinfo, lscpu");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьLscpuПриПустомCpuInfo() Экспорт

	// Подготовка
	Вызовы = Новый Массив();
	Lscpu = "Architecture: x86_64
	|CPU(s): 4
	|Socket(s): 1
	|Core(s) per socket: 2
	|CPU max MHz: 3000
	|Model name: Резервный CPU";
	Детектор = НастроенныйДетекторLinux(
		Новый МокИсточникИнформацииОПроцессоре("cpuinfo", Вызовы, ""),
		Новый МокИсточникИнформацииОПроцессоре("lscpu", Вызовы, Lscpu));

	// Действие
	Информация = Детектор.Определить();

	// Проверка
	Ожидаем.Что(Информация.ИмяПроцессора).Равно("Резервный CPU");
	Ожидаем.Что(Информация.КоличествоПроцессоров).Равно(1);
	Ожидаем.Что(Информация.КоличествоЯдер).Равно(2);
	Ожидаем.Что(Информация.КоличествоЛогическихПроцессоров).Равно(4);
	Ожидаем.Что(Информация.МаксимальнаяЧастота).Равно(3000000000);
	Ожидаем.Что(Информация.Архитектура).Равно(АрхитектурыПроцессоров.X64);
	Ожидаем.Что(СтрСоединить(Вызовы, ", ")).Равно("cpuinfo, lscpu");

КонецПроцедуры

&Тест
Процедура ТестДетектораLinux() Экспорт
	
	Детектор = Новый ДетекторПроцессораLinux();
	Если Не Детектор.Доступен() Тогда
		Возврат;
	КонецЕсли;

	ИнформацияОПроцессоре = Детектор.Определить();

	ПроверитьЗаполнение(ИнформацияОПроцессоре);

КонецПроцедуры

&Тест
Процедура ТестНедоступностиДетектораLinux() Экспорт
	
	Детектор = Новый ДетекторПроцессораLinux();
	Если Детектор.Доступен() Тогда
		Возврат;
	КонецЕсли;

	Ожидаем.Что(Детектор).Метод("Определить").ВыбрасываетИсключение("Детектор доступен только на Linux");

КонецПроцедуры

