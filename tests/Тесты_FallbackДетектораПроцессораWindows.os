#Использовать "helpers"

#Область Тесты

&Тест
Процедура ТестДолжен_ОстанавливатьсяПослеУспешногоComWmi() Экспорт

	// Подготовка
	Вызовы = Новый Массив();
	Детектор = НастроенныйДетектор(
		Новый МокИсточникИнформацииОПроцессореWindows("COM WMI", Вызовы, ДанныеПроцессора("COM CPU")),
		Новый МокИсточникИнформацииОПроцессореWindows("WMIC", Вызовы, , "WMIC не должен вызываться"),
		Новый МокИсточникИнформацииОПроцессореWindows("PowerShell CIM", Вызовы, , "CIM не должен вызываться"));

	// Действие
	Информация = Детектор.Определить();

	// Проверка
	Ожидаем.Что(Информация.ИмяПроцессора).Равно("COM CPU");
	ПроверитьВызовы(Вызовы, "COM WMI");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПереходитьСComWmiНаWmic() Экспорт

	// Подготовка
	Вызовы = Новый Массив();
	ПустыеДанные = Новый Массив();
	Детектор = НастроенныйДетектор(
		Новый МокИсточникИнформацииОПроцессореWindows("COM WMI", Вызовы, ПустыеДанные),
		Новый МокИсточникИнформацииОПроцессореWindows("WMIC", Вызовы, ДанныеПроцессора("WMIC CPU")),
		Новый МокИсточникИнформацииОПроцессореWindows("PowerShell CIM", Вызовы, , "CIM не должен вызываться"));

	// Действие
	Информация = Детектор.Определить();

	// Проверка
	Ожидаем.Что(Информация.ИмяПроцессора).Равно("WMIC CPU");
	ПроверитьВызовы(Вызовы, "COM WMI, WMIC");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПереходитьСWmicНаPowerShellCim() Экспорт

	// Подготовка
	Вызовы = Новый Массив();
	Детектор = НастроенныйДетектор(
		Новый МокИсточникИнформацииОПроцессореWindows("COM WMI", Вызовы, , "Ошибка COM"),
		Новый МокИсточникИнформацииОПроцессореWindows("WMIC", Вызовы, , "Ошибка WMIC"),
		Новый МокИсточникИнформацииОПроцессореWindows(
			"PowerShell CIM",
			Вызовы,
			ДанныеПроцессора("CIM CPU")));

	// Действие
	Информация = Детектор.Определить();

	// Проверка
	Ожидаем.Что(Информация.ИмяПроцессора).Равно("CIM CPU");
	ПроверитьВызовы(Вызовы, "COM WMI, WMIC, PowerShell CIM");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщатьПричиныОтказаВсехИсточниковWindows() Экспорт

	// Подготовка
	Вызовы = Новый Массив();
	Детектор = НастроенныйДетектор(
		Новый МокИсточникИнформацииОПроцессореWindows("COM WMI", Вызовы, , "Ошибка COM"),
		Новый МокИсточникИнформацииОПроцессореWindows("WMIC", Вызовы, , "Ошибка WMIC"),
		Новый МокИсточникИнформацииОПроцессореWindows("PowerShell CIM", Вызовы, , "Ошибка CIM"));
	ТекстОшибки = "";

	// Действие
	Попытка
		Детектор.Определить();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ТекстОшибки).Содержит("COM WMI: Ошибка COM");
	Ожидаем.Что(ТекстОшибки).Содержит("WMIC: Ошибка WMIC");
	Ожидаем.Что(ТекстОшибки).Содержит("PowerShell CIM: Ошибка CIM");
	ПроверитьВызовы(Вызовы, "COM WMI, WMIC, PowerShell CIM");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НастроенныйДетектор(ИсточникComWmi, ИсточникWmic, ИсточникPowerShellCim)

	Детектор = Новый ДетекторПроцессораWindows();
	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Детектор, "_ТипПлатформы", ТипПлатформы.Windows_x86_64);
	Рефлектор.УстановитьСвойство(Детектор, "_ИсточникComWmi", ИсточникComWmi);
	Рефлектор.УстановитьСвойство(Детектор, "_ИсточникWmic", ИсточникWmic);
	Рефлектор.УстановитьСвойство(Детектор, "_ИсточникPowerShellCim", ИсточникPowerShellCim);

	Возврат Детектор;

КонецФункции

Функция ДанныеПроцессора(Имя)

	Данные = Новый Массив();
	Данные.Добавить(Новый Структура(
		"Name, Architecture, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed",
		Имя,
		9,
		4,
		8,
		2500));

	Возврат Данные;

КонецФункции

Процедура ПроверитьВызовы(Вызовы, ОжидаемыеВызовы)

	Ожидаем.Что(СтрСоединить(Вызовы, ", ")).Равно(ОжидаемыеВызовы);

КонецПроцедуры

#КонецОбласти
