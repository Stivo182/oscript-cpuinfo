#Использовать "helpers"

#Область Тесты

&Тест
Процедура ПустойВвод() Экспорт

	// Подготовка
	ОжидаемыеФакты = СоздатьФакты();
	Парсер = Новый ПарсерДанныхПроцессораCpuInfo();

	// Действие
	Факты = Парсер.Распарсить("");

	// Проверка
	ПроверитьФакты(Факты, ОжидаемыеФакты);

КонецПроцедуры

&Тест
Процедура ПолныйВводX86() Экспорт

	// Подготовка
	ОжидаемыеФакты = СоздатьФакты();
	ОжидаемыеФакты.ИменаМоделей.Добавить("Example CPU A");
	ОжидаемыеФакты.ИменаМоделей.Добавить("Example CPU B");
	ОжидаемыеФакты.КоличествоЛогическихПроцессоров = 4;
	ОжидаемыеФакты.КоличествоПроцессоров = 1;
	ОжидаемыеФакты.КоличествоЯдерПоИдентификаторам.Вставить("0:0", Истина);
	ОжидаемыеФакты.КоличествоЯдерПоИдентификаторам.Вставить("0:1", Истина);
	ОжидаемыеФакты.КоличествоЯдерПоПроцессорам.Вставить("0", 2);
	ОжидаемыеФакты.МаксимальнаяЧастота = 2400000000;

	Cpuinfo =
	"processor: 0
	|physical id: 0
	|core id: 0
	|cpu cores: 2
	|model name: Example CPU A
	|max freq: 2300
	|
	|processor: 1
	|physical id: 0
	|core id: 0
	|cpu cores: 2
	|model name: Example CPU A
	|max freq: 2300
	|
	|processor: 2
	|physical id: 0
	|core id: 1
	|cpu cores: 2
	|model name: Example CPU B
	|max freq: 2400
	|
	|processor: 3
	|physical id: 0
	|core id: 1
	|cpu cores: 2
	|model name: Example CPU B
	|max freq: 2400";

	Парсер = Новый ПарсерДанныхПроцессораCpuInfo();

	// Действие
	Факты = Парсер.Распарсить(Cpuinfo);

	// Проверка
	ПроверитьФакты(Факты, ОжидаемыеФакты);

КонецПроцедуры

&Тест
Процедура ArmБезPhysicalId() Экспорт

	// Подготовка
	ОжидаемыеФакты = СоздатьФакты();
	ОжидаемыеФакты.ИмяПроцессора = "ARM Cortex-A72";
	ОжидаемыеФакты.Оборудование = "BCM2711";
	ОжидаемыеФакты.КоличествоЛогическихПроцессоров = 2;
	ОжидаемыеФакты.МаксимальнаяЧастота = 1800000000;

	Cpuinfo =
	"Processor: ARM Cortex-A72
	|Hardware: BCM2711
	|processor: 0
	|max freq: 1500
	|
	|Processor: Другой процессор
	|Hardware: Другое оборудование
	|processor: 1
	|max freq: 1800";

	Парсер = Новый ПарсерДанныхПроцессораCpuInfo();

	// Действие
	Факты = Парсер.Распарсить(Cpuinfo);

	// Проверка
	ПроверитьФакты(Факты, ОжидаемыеФакты);

КонецПроцедуры

&Тест
Процедура МаксимальнаяЧастотаИзПоследнегоНенулевогоЗначения() Экспорт

	// Подготовка
	ОжидаемыеФакты = СоздатьФакты();
	ОжидаемыеФакты.КоличествоЛогическихПроцессоров = 4;
	ОжидаемыеФакты.МаксимальнаяЧастота = 2200000000;

	Cpuinfo =
	"processor: 0
	|max freq: 3100
	|
	|processor: 1
	|max freq: 2200
	|
	|processor: 2
	|max freq: 0
	|
	|processor: 3";

	Парсер = Новый ПарсерДанныхПроцессораCpuInfo();

	// Действие
	Факты = Парсер.Распарсить(Cpuinfo);

	// Проверка
	ПроверитьФакты(Факты, ОжидаемыеФакты);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьФакты()

	Факты = Новый Структура();
	Факты.Вставить("ИменаМоделей", Новый Массив());
	Факты.Вставить("ИмяПроцессора", "");
	Факты.Вставить("Оборудование", "");
	Факты.Вставить("КоличествоЛогическихПроцессоров", 0);
	Факты.Вставить("КоличествоПроцессоров", 0);
	Факты.Вставить("КоличествоЯдерПоИдентификаторам", Новый Соответствие());
	Факты.Вставить("КоличествоЯдерПоПроцессорам", Новый Соответствие());
	Факты.Вставить("МаксимальнаяЧастота", 0);

	Возврат Факты;

КонецФункции

Процедура ПроверитьФакты(Факты, ОжидаемыеФакты)

	Ожидаем.Что(ТипЗнч(Факты)).Равно(Тип("Структура"));
	Ожидаем.Что(Факты.ИменаМоделей.Количество()).Равно(ОжидаемыеФакты.ИменаМоделей.Количество());
	Для Индекс = 0 По ОжидаемыеФакты.ИменаМоделей.ВГраница() Цикл
		Ожидаем.Что(Факты.ИменаМоделей[Индекс]).Равно(ОжидаемыеФакты.ИменаМоделей[Индекс]);
	КонецЦикла;
	Ожидаем.Что(Факты.ИмяПроцессора).Равно(ОжидаемыеФакты.ИмяПроцессора);
	Ожидаем.Что(Факты.Оборудование).Равно(ОжидаемыеФакты.Оборудование);
	Ожидаем.Что(Факты.КоличествоЛогическихПроцессоров).Равно(ОжидаемыеФакты.КоличествоЛогическихПроцессоров);
	Ожидаем.Что(Факты.КоличествоПроцессоров).Равно(ОжидаемыеФакты.КоличествоПроцессоров);
	Ожидаем.Что(Факты.КоличествоЯдерПоИдентификаторам.Количество()).Равно(ОжидаемыеФакты.КоличествоЯдерПоИдентификаторам.Количество());
	Для Каждого Строка Из ОжидаемыеФакты.КоличествоЯдерПоИдентификаторам Цикл
		Ожидаем.Что(Факты.КоличествоЯдерПоИдентификаторам[Строка.Ключ]).Равно(Строка.Значение);
	КонецЦикла;
	Ожидаем.Что(Факты.КоличествоЯдерПоПроцессорам.Количество()).Равно(ОжидаемыеФакты.КоличествоЯдерПоПроцессорам.Количество());
	Для Каждого Строка Из ОжидаемыеФакты.КоличествоЯдерПоПроцессорам Цикл
		Ожидаем.Что(Факты.КоличествоЯдерПоПроцессорам[Строка.Ключ]).Равно(Строка.Значение);
	КонецЦикла;
	Ожидаем.Что(Факты.МаксимальнаяЧастота).Равно(ОжидаемыеФакты.МаксимальнаяЧастота);

КонецПроцедуры

#КонецОбласти
