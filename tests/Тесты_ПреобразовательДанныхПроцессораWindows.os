#Использовать "helpers"
#Использовать logos

#Область Тесты

&Тест
Процедура ТестДолжен_ПреобразовыватьДанныеНесколькихПроцессоров() Экспорт

	// Подготовка
	ДанныеПроцессоров = Новый Массив();
	ДанныеПроцессоров.Добавить(ДанныеПроцессора("Первый CPU", 9, 8, 16, 3000));
	ДанныеПроцессоров.Добавить(ДанныеПроцессора("Второй CPU", 9, 8, 16, 3200));
	Преобразователь = Новый ПреобразовательДанныхПроцессораWindows();

	// Действие
	Информация = Преобразователь.Преобразовать(ДанныеПроцессоров);

	// Проверка
	Ожидаем.Что(Информация.ИмяПроцессора).Равно("Первый CPU, Второй CPU");
	Ожидаем.Что(Информация.КоличествоПроцессоров).Равно(2);
	Ожидаем.Что(Информация.КоличествоЯдер).Равно(16);
	Ожидаем.Что(Информация.КоличествоЛогическихПроцессоров).Равно(32);
	Ожидаем.Что(Информация.МаксимальнаяЧастота).Равно(3100000000);
	Ожидаем.Что(Информация.НоминальнаяЧастота).Равно(3100000000);
	Ожидаем.Что(Информация.Архитектура).Равно(АрхитектурыПроцессоров.X64);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеДублироватьОдинаковыеИменаПроцессоров() Экспорт

	// Подготовка
	ДанныеПроцессоров = Новый Массив();
	ДанныеПроцессоров.Добавить(ДанныеПроцессора("Одинаковый CPU", 9, 4, 8, 2500));
	ДанныеПроцессоров.Добавить(ДанныеПроцессора("Одинаковый CPU", 9, 4, 8, 2500));
	Преобразователь = Новый ПреобразовательДанныхПроцессораWindows();

	// Действие
	Информация = Преобразователь.Преобразовать(ДанныеПроцессоров);

	// Проверка
	Ожидаем.Что(Информация.ИмяПроцессора).Равно("Одинаковый CPU");
	Ожидаем.Что(Информация.КоличествоПроцессоров).Равно(2);

КонецПроцедуры

&Тест
&Параметры("Неполный CPU", 9, 0, 0)
&Параметры("Неполный CPU", 99, 4, 8)
&Параметры("", 9, 4, 8)
Процедура ТестДолжен_ОтклонятьНеполныеДанныеОдногоИзПроцессоров(
		ИмяПроцессора,
		КодАрхитектуры,
		КоличествоЯдер,
		КоличествоЛогическихПроцессоров) Экспорт

	// Подготовка
	ДанныеПроцессоров = Новый Массив();
	ДанныеПроцессоров.Добавить(ДанныеПроцессора("Полный CPU", 9, 4, 8, 2500));
	ДанныеПроцессоров.Добавить(ДанныеПроцессора(
		ИмяПроцессора,
		КодАрхитектуры,
		КоличествоЯдер,
		КоличествоЛогическихПроцессоров,
		2500));
	ПараметрыМетода = Новый Массив();
	ПараметрыМетода.Добавить(ДанныеПроцессоров);
	Преобразователь = Новый ПреобразовательДанныхПроцессораWindows();

	// Действие и Проверка
	Ожидаем.Что(Преобразователь)
		.Метод("Преобразовать", ПараметрыМетода)
		.ВыбрасываетИсключение("Данные процессора не содержат обязательные сведения");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчитыватьТолькоЗаполненныеЧастотыПроцессоров() Экспорт

	// Подготовка
	ДанныеПроцессоров = Новый Массив();
	ДанныеПроцессоров.Добавить(ДанныеПроцессора("Первый CPU", 9, 4, 8, 3000));
	ДанныеПроцессоров.Добавить(ДанныеПроцессора("Второй CPU", 9, 4, 8, 0));
	Преобразователь = Новый ПреобразовательДанныхПроцессораWindows();

	// Действие
	Информация = Преобразователь.Преобразовать(ДанныеПроцессоров);

	// Проверка
	Ожидаем.Что(Информация.МаксимальнаяЧастота).Равно(3000000000);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЛогироватьПреобразованиеДанныхПроцессоров() Экспорт

	// Подготовка
	ДанныеПроцессоров = Новый Массив();
	ДанныеПроцессоров.Добавить(ДанныеПроцессора("CPU", 9, 4, 8, 3000));
	Преобразователь = Новый ПреобразовательДанныхПроцессораWindows();
	Лог = Логирование.ПолучитьЛог("oscript.lib.cpuinfo.windows.converter");
	Накопитель = Новый НакопительСообщенийЛога();
	Лог.ДобавитьСпособВывода(Накопитель, УровниЛога.Отладка);

	// Действие
	Попытка
		Преобразователь.Преобразовать(ДанныеПроцессоров);
	Исключение
		Лог.УдалитьСпособВывода(Накопитель);
		ВызватьИсключение;
	КонецПопытки;
	Сообщения = Накопитель.ПолучитьСообщения();
	Уровни = Накопитель.ПолучитьУровни();
	Лог.УдалитьСпособВывода(Накопитель);

	// Проверка
	Ожидаем.Что(СтрСоединить(Сообщения, Символы.ПС)).Содержит("Преобразование данных процессоров Windows");
	Ожидаем.Что(Уровни[0]).Равно(УровниЛога.Отладка);

КонецПроцедуры

&Тест
&Параметры(0, "X86")
&Параметры(5, "ARM")
&Параметры(9, "X64")
&Параметры(12, "ARM64")
Процедура ТестДолжен_ПреобразовыватьКодАрхитектурыWindows(КодАрхитектуры, ОжидаемаяАрхитектура) Экспорт

	// Подготовка
	ДанныеПроцессоров = Новый Массив();
	ДанныеПроцессоров.Добавить(ДанныеПроцессора("CPU", КодАрхитектуры, 1, 1, 1000));
	Преобразователь = Новый ПреобразовательДанныхПроцессораWindows();

	// Действие
	Информация = Преобразователь.Преобразовать(ДанныеПроцессоров);

	// Проверка
	Ожидаем.Что(Информация.Архитектура).Равно(ОжидаемаяАрхитектура);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеПроцессора(Имя, КодАрхитектуры, КоличествоЯдер, КоличествоЛогическихПроцессоров, МаксимальнаяЧастота)

	Возврат Новый Структура(
		"Имя, КодАрхитектуры, КоличествоЯдер, КоличествоЛогическихПроцессоров, МаксимальнаяЧастотаМГц",
		Имя,
		КодАрхитектуры,
		КоличествоЯдер,
		КоличествоЛогическихПроцессоров,
		МаксимальнаяЧастота);

КонецФункции

#КонецОбласти
