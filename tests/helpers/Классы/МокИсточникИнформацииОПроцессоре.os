Перем _Имя; // Строка
Перем _Вызовы; // Массив
Перем _Результат; // Произвольный
Перем _ТекстОшибки; // Строка

#Область ОбработчикиСобытий

// Создает источник с управляемым результатом или ошибкой.
//
// Параметры:
//   Имя - Строка - имя, записываемое при вызове источника.
//   Вызовы - Массив - журнал вызовов источников.
//   Результат - Произвольный - возвращаемые данные источника.
//   ТекстОшибки - Строка - текст исключения; пустая строка отключает ошибку.
Процедура ПриСозданииОбъекта(Имя, Вызовы, Результат = Неопределено, ТекстОшибки = "")

	_Имя = Имя;
	_Вызовы = Вызовы;
	_Результат = Результат;
	_ТекстОшибки = ТекстОшибки;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает настроенный результат и регистрирует вызов.
//
// Возвращаемое значение:
//   Произвольный - настроенные данные источника.
Функция Получить() Экспорт

	_Вызовы.Добавить(_Имя);

	Если ЗначениеЗаполнено(_ТекстОшибки) Тогда
		ВызватьИсключение _ТекстОшибки;
	КонецЕсли;

	Возврат _Результат;

КонецФункции

#КонецОбласти
