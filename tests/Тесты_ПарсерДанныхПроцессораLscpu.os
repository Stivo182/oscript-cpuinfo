#Использовать "helpers"

#Область Тесты

&Тест
Процедура ТестДолжен_ВозвращатьФактыПоУмолчаниюДляПустогоLscpu() Экспорт

	// Подготовка
	Парсер = Новый ПарсерДанныхПроцессораLscpu();

	// Действие
	Факты = Парсер.Распарсить("");

	// Проверка
	ПроверитьФакты(Факты, "", Неопределено, 0, 0, 0, 0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзвлекатьПоддерживаемыеПоляLscpu() Экспорт

	// Подготовка
	Lscpu =
	" Architecture : x86_64
	| CPU(s) : 16
	| Socket(s) : 2
	| Core(s) per socket : 8
	| CPU max MHz : 3600.5
	| Model name : Example CPU
	| Unknown field : ignored
	| CPU min MHz : ";

	Парсер = Новый ПарсерДанныхПроцессораLscpu();

	// Действие
	Факты = Парсер.Распарсить(Lscpu);

	// Проверка
	ПроверитьФакты(Факты, "Example CPU", АрхитектурыПроцессоров.X64, 16, 2, 8, 3600500000);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаспознаватьАрхитектурыLscpu() Экспорт

	// Подготовка
	ТестовыеСлучаи = Новый Соответствие();
	ТестовыеСлучаи.Вставить("x86", АрхитектурыПроцессоров.X86);
	ТестовыеСлучаи.Вставить("x86_64", АрхитектурыПроцессоров.X64);
	ТестовыеСлучаи.Вставить("armv7l", АрхитектурыПроцессоров.ARM);
	ТестовыеСлучаи.Вставить("aarch64", АрхитектурыПроцессоров.ARM64);
	ТестовыеСлучаи.Вставить("unknown", Неопределено);

	Парсер = Новый ПарсерДанныхПроцессораLscpu();

	// Действие и Проверка
	Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл
		Факты = Парсер.Распарсить("Architecture: " + ТестовыйСлучай.Ключ);
		Ожидаем.Что(Факты.Архитектура, ТестовыйСлучай.Ключ).Равно(ТестовыйСлучай.Значение);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаспознаватьАрхитектуруПослеBOM() Экспорт

	// Подготовка
	Парсер = Новый ПарсерДанныхПроцессораLscpu();
	Lscpu = Символ(65279) + "Architecture: x86_64";

	// Действие
	Факты = Парсер.Распарсить(Lscpu);

	// Проверка
	Ожидаем.Что(Факты.Архитектура).Равно(АрхитектурыПроцессоров.X64);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НормализоватьНеположительныеИНекорректныеЧислаВНоль() Экспорт

	// Подготовка
	ТестовыеЗначения = Новый Массив();
	ТестовыеЗначения.Добавить("0");
	ТестовыеЗначения.Добавить("-1");
	ТестовыеЗначения.Добавить("не число");

	Парсер = Новый ПарсерДанныхПроцессораLscpu();

	// Действие и Проверка
	Для Каждого ТестовоеЗначение Из ТестовыеЗначения Цикл
		Lscpu = СтрШаблон(
			"CPU(s): %1
			|Socket(s): %1
			|Core(s) per socket: %1
			|CPU max MHz: %1",
			ТестовоеЗначение);

		Факты = Парсер.Распарсить(Lscpu);

		ПроверитьФакты(Факты, "", Неопределено, 0, 0, 0, 0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьФакты(Факты, ИмяМодели, Архитектура, КоличествоЛогическихПроцессоров, КоличествоПроцессоров, КоличествоЯдерВСокете, МаксимальнаяЧастота)

	Ожидаем.Что(ТипЗнч(Факты)).Равно(Тип("Структура"));
	Ожидаем.Что(Факты.ИмяМодели).Равно(ИмяМодели);
	Ожидаем.Что(Факты.Архитектура).Равно(Архитектура);
	Ожидаем.Что(Факты.КоличествоЛогическихПроцессоров).Равно(КоличествоЛогическихПроцессоров);
	Ожидаем.Что(Факты.КоличествоПроцессоров).Равно(КоличествоПроцессоров);
	Ожидаем.Что(Факты.КоличествоЯдерВСокете).Равно(КоличествоЯдерВСокете);
	Ожидаем.Что(Факты.МаксимальнаяЧастота).Равно(МаксимальнаяЧастота);

КонецПроцедуры

#КонецОбласти
